---
// Starlight's own title, plus a button that copies this page's Markdown copy (/docs/<id>.md).
import Default from "@astrojs/starlight/components/PageTitle.astro";

const md = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${Astro.locals.starlightRoute.id || "index"}.md`;
---

<Default />
<button type="button" class="hv-copy-md" data-md={md}>Copy as Markdown</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".hv-copy-md")) {
    button.addEventListener("click", async () => {
      try {
        const text = await (await fetch(button.dataset.md!)).text();
        await navigator.clipboard.writeText(text);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Couldn't copy";
      }
    });
  }
</script>
